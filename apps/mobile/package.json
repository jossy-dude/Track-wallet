{
  "name": "@omni-sync/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android:doctor": "node ./android/tools/android-host.mjs doctor",
    "android:targets": "node ./android/tools/android-host.mjs targets",
    "android:sync": "node ./android/tools/android-host.mjs sync",
    "android:build:debug": "node ./android/tools/android-host.mjs assembleDebug",
    "android:build:release": "node ./android/tools/android-host.mjs assembleRelease",
    "android:install:debug": "node ./android/tools/android-host.mjs installDebug",
    "android:smoke:debug": "node ./android/tools/android-host.mjs smokeDebug",
    "cap:sync": "npm run android:sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@omni-sync/core": "0.1.0",
    "@omni-sync/database": "0.1.0",
    "@omni-sync/mobile-sms-capture": "0.1.0",
    "@omni-sync/ui": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
